<Project Sdk="Microsoft.NET.Sdk">
  <!-- A stand-in for REPO that drives the real Minecraft mod through the plugin's own link,
       protocol and collision code (no Unity): for testing the Minecraft half and the protocol. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\plugin\src\Link\Proto.cs" Link="Shared\Proto.cs" />
    <Compile Include="..\..\plugin\src\Link\SharedLink.cs" Link="Shared\SharedLink.cs" />
    <Compile Include="..\..\plugin\src\World\CollisionWorker.cs" Link="Shared\CollisionWorker.cs" />
    <Compile Include="..\..\plugin\src\World\Clip.cs" Link="Shared\Clip.cs" />
    <Compile Include="..\..\plugin\src\World\DugBlocks.cs" Link="Shared\DugBlocks.cs" />
  </ItemGroup>
</Project>
